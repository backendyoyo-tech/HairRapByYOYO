// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTIONIST
  ARTIST
  CLIENT
}

enum AccountType {
  STAFF
  ARTIST
  CLIENT
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// ============================================================
// CLUSTER 4 — BOOKING & AVAILABILITY ENUMS (Day 6)
// ============================================================

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  IN_SERVICE
  SERVICE_COMPLETED
  CLOSED
  CANCELLED
  NO_SHOW
}

enum AssignmentStrategy {
  SPECIFIC_ARTIST
  AUTO_ASSIGN
  YOYO_ASSIGNED_TEAM
}

enum AssignmentStatus {
  AWAITING_ASSIGNMENT
  PARTIALLY_ASSIGNED
  FULLY_ASSIGNED
  ASSIGNMENT_EXCEPTION
}

enum ArtistConfirmationState {
  NONE
  PROVISIONAL
  FINAL
  CONFIRMATION_EXCEPTION
}

enum AssignmentRole {
  PRIMARY
  LEAD
  SUPPORT
}

enum AssignmentSource {
  CLIENT_REQUEST
  FLOOR_MANAGER
  RECEPTIONIST
  AUTO_STANDARD_RESERVED_P2
}

enum AssignmentRowStatus {
  PENDING
  CONFIRMED
  RELEASED
  REPLACED
}

enum HoldStatus {
  HOLD_ACTIVE
  HOLD_CONSUMED
  HOLD_EXPIRED
  HOLD_RELEASED
}

enum SessionStatusEnum {
  NOT_STARTED
  ACTIVE
  READY_FOR_BILLING
}

enum ConsultationReviewOutcome {
  NO_CHANGES
  UPDATED
}

enum ConsentStatus {
  SIGNED
  DECLINED
  MISSING
}

enum MediaConsent {
  ALLOW
  DECLINE
  NOT_ANSWERED
}

enum PaymentPurpose {
  ADVANCE
  FINAL
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReconciliationState {
  CLEAN
  REQUIRED
  IN_REVIEW
  RESOLVED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  SUCCEEDED
  FAILED
  REJECTED
  CANCELLED
}

enum RefundDestination {
  ORIGINAL
  WALLET
  MEMBERSHIP
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
}

enum MembershipMemberStatus {
  ACTIVE
  REMOVED
}

enum MembershipTxnType {
  PURCHASE_GRANT
  SERVICE_DEBIT
  REFUND_CREDIT
  MANUAL_ADJUSTMENT
  RENEWAL_RESERVED
  EXPIRY_RESERVED
}

enum ExpenseApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  VOIDED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  DUPLICATE
  FAILED_RETRYABLE
  FAILED_FINAL
}

model Account {
  id              String       @id @default(cuid())
  accountType     AccountType
  email           String?      @unique
  phone           String?      @unique
  username        String?      @unique
  passwordHash    String?
  role            Role         @default(CLIENT)
  isActive        Boolean      @default(true)
  isVerified      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastLoginAt     DateTime?

  // Relations
  staffProfile    StaffProfile?
  artistProfile   ArtistProfile?
  clientProfile   ClientProfile?
  sessions        Session[]
  otps            OTP[]
  wishlistItems   WishlistItem[]

  @@index([accountType])
  @@index([email])
  @@index([phone])
  @@index([username])
}

model StaffProfile {
  id          String   @id @default(cuid())
  accountId   String   @unique
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  employeeId  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ArtistProfile {
  id              String   @id @default(cuid())
  accountId       String   @unique
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  displayName     String
  specialization  String?
  bio             String?
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  artistServices  ArtistService[]
  workSchedules   ArtistWorkSchedule[]
  scheduleExceptions ArtistScheduleException[]
  bookingAssignments BookingServiceAssignment[]

  @@index([isAvailable])
}

model ClientProfile {
  id            String   @id @default(cuid())
  accountId     String   @unique
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  preferences   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings      Booking[]
  holds         BookingHold[]
  payments      Payment[]
  invoices      Invoice[]
  refunds       Refund[]
}

model Session {
  id           String             @id @default(cuid())
  accountId    String
  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  refreshToken String         @unique
  accessToken  String         @unique
  status       SessionStatus @default(ACTIVE)
  expiresAt    DateTime
  createdAt    DateTime       @default(now())
  revokedAt    DateTime?
  userAgent    String?
  ipAddress    String?

  @@index([accountId])
  @@index([refreshToken])
  @@index([accessToken])
  @@index([status])
  @@index([expiresAt])
}

model OTP {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  code      String
  purpose   String   // "login", "registration", "password_reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([accountId, purpose])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  accountId   String?
  actorType   String?  // "STAFF", "ARTIST", "CLIENT", "SYSTEM"
  actorId     String?
  action      String   // "LOGIN", "LOGOUT", "OTP_SENT", "OTP_VERIFIED", "TOKEN_REFRESH", "LOGIN_FAILED", etc.
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  success     Boolean  @default(true)
  errorCode   String?
  createdAt   DateTime @default(now())

  @@index([accountId])
  @@index([actorType, actorId])
  @@index([action])
  @@index([createdAt])
  @@index([success])
}

// ============================================================
// CLUSTER 3 — CATALOGUE & INVENTORY (Day 5)
// ============================================================

enum ServiceGender {
  MALE
  FEMALE
  UNISEX
}

enum RiskClass {
  NORMAL
  HIGH_RISK
}

enum ProductType {
  RETAIL
  TOOLS
  SALON_USE
}

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subcategories ServiceSubcategory[]

  @@index([isActive, displayOrder])
}

model ServiceSubcategory {
  id              String   @id @default(cuid())
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  services Service[]

  @@index([categoryId, isActive, displayOrder])
  @@unique([categoryId, name])
}

model Service {
  id                          String       @id @default(cuid())
  subcategoryId               String?
  subcategory                 ServiceSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  name                        String
  description                 String?
  durationMinutes             Int
  gender                      ServiceGender @default(UNISEX)
  requiredArtistCount         Int          @default(1)
  active                      Boolean      @default(true)
  creativeDirectorEligible    Boolean      @default(false)
  allowsParallelClientService Boolean      @default(false)
  riskClass                   RiskClass    @default(NORMAL)
  requiresServiceConsent      Boolean      @default(false)
  price                       Decimal      @db.Decimal(10, 2)
  displayOrder                Int          @default(0)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  artistServices          ArtistService[]
  bookingServices         BookingService[]
  serviceProductSuggestions ServiceProductSuggestion[]

  @@index([active, displayOrder])
  @@index([subcategoryId])
  @@index([gender, active])
}

model ProductCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, displayOrder])
}

model Product {
  id                String       @id @default(cuid())
  categoryId        String
  category          ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  type              ProductType  @default(RETAIL)
  price             Decimal      @db.Decimal(10, 2)
  cost              Decimal?     @db.Decimal(10, 2)
  stockQty          Int          @default(0)
  lowStockThreshold Int          @default(5)
  sku               String?      @unique
  barcode           String?      @unique
  isActive          Boolean      @default(true)
  displayOrder      Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  inventoryMovements      InventoryMovement[]
  serviceProductSuggestions ServiceProductSuggestion[]

  @@index([categoryId, isActive, displayOrder])
  @@index([sku])
  @@index([barcode])
  @@index([isActive, type])
}

model InventoryMovement {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int      // positive = in, negative = out
  reason          String   // "sale", "purchase", "adjustment", "transfer", "return"
  referenceId     String?  // booking_id, purchase_order_id, etc.
  referenceType   String?  // "booking", "purchase_order", "adjustment"
  performedByAccountId String?
  createdAt       DateTime @default(now())

  @@index([productId, createdAt])
  @@index([referenceId, referenceType])
}

model ServiceProductSuggestion {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())

  @@unique([serviceId, productId])
  @@index([serviceId])
}

model WishlistItem {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  itemType    String   // "SERVICE", "PRODUCT", "ARTIST"
  itemId      String
  createdAt   DateTime @default(now())

  @@unique([accountId, itemType, itemId])
  @@index([accountId])
}

// ============================================================
// CLUSTER 2 — BOOKING & ASSIGNMENT (referenced by Catalogue)
// ============================================================

model ArtistService {
  id          String   @id @default(cuid())
  artistId    String
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([artistId, serviceId])
  @@index([artistId, isActive])
  @@index([serviceId, isActive])
}

model BookingService {
  id                      String   @id @default(cuid())
  bookingId               String
  booking                 Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId               String
  service                 Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assignmentStrategy      AssignmentStrategy
  requestedArtistId       String?
  plannedStartAt          DateTime
  plannedEndAt            DateTime
  bufferMinutes           Int      @default(10)
  executionStatus         SessionStatusEnum @default(NOT_STARTED)
  actualStartAt           DateTime?
  actualEndAt             DateTime?
  priceSnapshot           Decimal  @db.Decimal(10, 2)
  assignmentStatus        AssignmentStatus @default(AWAITING_ASSIGNMENT)
  artistConfirmationState ArtistConfirmationState @default(NONE)
  version                 Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  assignments BookingServiceAssignment[]
  sessions    ServiceSession[]
  consents    ServiceConsent[]

  @@index([bookingId])
  @@index([serviceId])
  @@index([assignmentStatus])
  @@index([plannedStartAt])
}

model BookingServiceAssignment {
  id                 String   @id @default(cuid())
  bookingServiceId   String
  bookingService     BookingService @relation(fields: [bookingServiceId], references: [id], onDelete: Cascade)
  artistId           String
  artist             ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  role               AssignmentRole
  assignmentSource   AssignmentSource
  status             AssignmentRowStatus @default(PENDING)
  assignedByStaffId  String?
  assignedAt         DateTime @default(now())

  @@unique([bookingServiceId, artistId])
  @@index([bookingServiceId, status])
  @@index([artistId, status])
}

model ServiceSession {
  id                   String   @id @default(cuid())
  bookingServiceId     String   @unique
  bookingService       BookingService @relation(fields: [bookingServiceId], references: [id], onDelete: Cascade)
  status               SessionStatusEnum @default(NOT_STARTED)
  ownerArtistId        String?
  startedAt            DateTime?
  readyForBillingAt    DateTime?
  durationMinutes      Int?
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  events SessionEvent[]

  @@index([status])
}

model SessionEvent {
  id                  String   @id @default(cuid())
  serviceSessionId    String
  serviceSession      ServiceSession @relation(fields: [serviceSessionId], references: [id], onDelete: Cascade)
  eventType           String   // "STARTED", "PAUSED", "RESUMED", "COMPLETED", "READY_FOR_BILLING"
  actorType           String   // "ARTIST", "SYSTEM"
  actorId             String
  idempotencyKey      String   @unique
  occurredAt          DateTime @default(now())

  @@index([serviceSessionId, occurredAt])
}

model ServiceConsent {
  id              String   @id @default(cuid())
  bookingServiceId String
  bookingService   BookingService @relation(fields: [bookingServiceId], references: [id], onDelete: Cascade)
  clientId        String
  templateId      String
  templateVersion Int
  status          String   // "PENDING", "SIGNED", "DECLINED"
  signatureRef    String?
  signedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([bookingServiceId, clientId, templateId])
  @@index([bookingServiceId, status])
}

// ============================================================
// CLUSTER 5 — BOOKING & AVAILABILITY MODELS (Day 6)
// ============================================================

model Booking {
  id                  String   @id @default(cuid())
  clientId            String
  client              ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status              BookingStatus @default(CONFIRMED)
  assignmentStrategy  AssignmentStrategy
  totalPrice          Decimal  @db.Decimal(10, 2)
  totalAdvanceRequired Decimal @db.Decimal(10, 2)
  advanceRule         String   // "STANDARD_20_PERCENT", "SPECIFIC_CREATIVE_DIRECTOR_FIXED"
  version             Int      @default(1)
  confirmedAt         DateTime?
  checkedInAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  services            BookingService[]
  holds               BookingHold[]
  statusHistory       BookingStatusHistory[]
  rescheduleHistory   BookingRescheduleHistory[]
  payments            Payment[]
  invoice             Invoice?

  @@index([clientId, status])
  @@index([status])
  @@index([createdAt])
}

model BookingHold {
  id              String   @id @default(cuid())
  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId        String
  client          ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quoteId         String   @unique
  status          HoldStatus @default(HOLD_ACTIVE)
  expiresAt       DateTime
  totalAdvanceAmount Decimal @db.Decimal(10, 2)
  advanceRule     String
  idempotencyKey  String   @unique
  consumedAt      DateTime?
  releasedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  resources       BookingHoldResource[]

  @@index([clientId, status])
  @@index([status, expiresAt])
  @@index([quoteId])
}

model BookingHoldResource {
  id              String   @id @default(cuid())
  holdId          String
  hold            BookingHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  bookingServiceId String?
  artistId        String?
  resourceType    String   // "ARTIST_SLOT", "ANONYMOUS_CAPACITY"
  startAt         DateTime
  endAt           DateTime
  createdAt       DateTime @default(now())

  @@unique([holdId, artistId, startAt, endAt])
  @@index([holdId])
  @@index([artistId, startAt, endAt])
}

model BookingQuote {
  id                  String   @id @default(cuid())
  clientId            String
  services            Json     // Array of service items with pricing
  serviceTotal        Decimal  @db.Decimal(10, 2)
  advanceRule         String   // "STANDARD_20_PERCENT", "SPECIFIC_CREATIVE_DIRECTOR_FIXED"
  advanceRequired     Decimal  @db.Decimal(10, 2)
  expiresAt           DateTime
  warnings            Json?    // Non-blocking warnings
  createdAt           DateTime @default(now())

  @@index([clientId, createdAt])
}

model BookingStatusHistory {
  id          String       @id @default(cuid())
  bookingId   String
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  actorType   String       // "STAFF", "ARTIST", "CLIENT", "SYSTEM"
  actorId     String?
  reason      String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  @@index([bookingId, createdAt])
}

model BookingRescheduleHistory {
  id                  String   @id @default(cuid())
  bookingId           String
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reason              String
  oldServicesJson     Json     // Previous service windows
  newServicesJson     Json     // New service windows
  moneyActionRequired Boolean  @default(false)
  actorType           String   // "STAFF", "CLIENT"
  actorId             String
  idempotencyKey      String   @unique
  createdAt           DateTime @default(now())

  @@index([bookingId, createdAt])
}

model ArtistWorkSchedule {
  id          String   @id @default(cuid())
  artistId    String
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime   DateTime // Time component only (date part ignored)
  endTime     DateTime // Time component only (date part ignored)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([artistId, dayOfWeek, startTime, endTime])
  @@index([artistId, dayOfWeek, isActive])
}

model ArtistScheduleException {
  id          String   @id @default(cuid())
  artistId    String
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  exceptionDate DateTime
  startTime   DateTime? // Null = full day off
  endTime     DateTime? // Null = full day off
  reason      String?
  isAvailable Boolean  @default(false) // true = extra availability, false = day off
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([artistId, exceptionDate, startTime, endTime])
  @@index([artistId, exceptionDate])
  @@index([exceptionDate, isAvailable])
}

model IdempotencyKey {
  id              String   @id @default(cuid())
  key             String   @unique
  endpoint        String
  method          String
  requestHash     String   // Hash of canonical request payload
  responseStatus  Int?
  responseBody    Json?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([key])
  @@index([expiresAt])
}

// ============================================================
// CLUSTER 6 — PAYMENTS & FINANCE (Day 9)
// ============================================================

model Payment {
  id                  String   @id @default(cuid())
  bookingId           String?
  booking             Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoiceId           String?
  invoice             Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  clientId            String
  client              ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  purpose             PaymentPurpose
  status              PaymentStatus @default(INITIATED)
  amount              Decimal  @db.Decimal(10, 2)
  currency            String   @default("INR")
  provider            String?  // "razorpay", "cash", "wallet", "membership"
  providerPaymentId   String?  @unique
  providerOrderId     String?
  providerSignature   String?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  succeededAt         DateTime?
  failedAt            DateTime?
  cancelledAt         DateTime?

  refunds             Refund[]

  @@index([bookingId])
  @@index([invoiceId])
  @@index([clientId, status])
  @@index([providerPaymentId])
  @@index([status, createdAt])
}

model PaymentWebhookEvent {
  id                  String   @id @default(cuid())
  provider            String   // "razorpay"
  providerEventId     String   @unique
  eventType           String   // "payment.captured", "payment.failed", etc.
  payload             Json
  processingStatus    WebhookProcessingStatus @default(RECEIVED)
  errorMessage        String?
  processedAt         DateTime?
  createdAt           DateTime @default(now())

  @@index([providerEventId])
  @@index([provider, eventType])
  @@index([processingStatus])
}

model Invoice {
  id                  String   @id @default(cuid())
  bookingId           String   @unique
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId            String
  client              ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status              String   // "OPEN", "PARTIALLY_SETTLED", "CLOSED"
  totalAmount         Decimal  @db.Decimal(10, 2)
  advanceApplied      Decimal  @db.Decimal(10, 2) @default(0)
  cashApplied         Decimal  @db.Decimal(10, 2) @default(0)
  onlineApplied       Decimal  @db.Decimal(10, 2) @default(0)
  walletApplied       Decimal  @db.Decimal(10, 2) @default(0)
  membershipApplied   Decimal  @db.Decimal(10, 2) @default(0)
  tipAmount           Decimal  @db.Decimal(10, 2) @default(0)
  closedAt            DateTime?
  closedByAccountId   String?
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  lineItems           InvoiceLineItem[]
  payments            Payment[]

  @@index([clientId, status])
  @@index([status, createdAt])
}

model InvoiceLineItem {
  id                  String   @id @default(cuid())
  invoiceId           String
  invoice             Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type                String   // "SERVICE", "PRODUCT", "TIP", "FEE"
  description         String
  quantity            Int      @default(1)
  unitPrice           Decimal  @db.Decimal(10, 2)
  totalPrice          Decimal  @db.Decimal(10, 2)
  bookingServiceId    String?
  productId           String?
  artistId            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([invoiceId])
  @@index([bookingServiceId])
}

model Refund {
  id                  String   @id @default(cuid())
  paymentId           String
  payment             Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  clientId            String
  client              ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount              Decimal  @db.Decimal(10, 2)
  status              RefundStatus @default(REQUESTED)
  destination         RefundDestination?
  reason              String?
  approvedByAccountId String?
  approvedAt          DateTime?
  executedAt          DateTime?
  providerRefundId    String?
  idempotencyKey      String   @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([paymentId])
  @@index([clientId, status])
  @@index([status, createdAt])
}